# Copy to .env and adjust — never commit real secrets here.
# extra="forbid": any FRAUD_* variable NOT listed below crashes the
# service at startup, so keep this file in step with config.py.
FRAUD_MODEL_PATH=models/fraud_model.joblib
FRAUD_BLOCK_THRESHOLD=0.85
FRAUD_LOG_LEVEL=INFO

# Injected by CI (the commit the image was built from); defaults to "dev" locally.
FRAUD_GIT_SHA=dev

# Registry credential — SecretStr. Leave EMPTY here; supply the real
# value from the platform secret store, never from a committed file.
# FRAUD_REGISTRY_TOKEN=
